# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=localhost:3000

# Security (generate a random 32+ character string for production)
PORTAL_SESSION_SECRET=replace-with-32-byte-random-hex-secret

# Supabase (PostgreSQL + Auth + RLS)
# Leave blank to run in Interactive Studio Sandbox Mode locally
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary (Signed Deliverable Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe Invoicing & Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (Optional Zero-Cost Transactional Email Notifications)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ClientPortal <onboarding@resend.dev>
